tap "homebrew/cask"
tap "homebrew/core"
tap "homebrew/bundle"
tap "homebrew/services"
# GNU file, shell, and text utilities.
brew "coreutils"
# GNU tools for comparing files and directories.
brew "diffutils"
# GNU find, xargs, and locate utilities.
brew "findutils"
# GNU awk for processing structured text.
brew "gawk"
# GNU stream editor for transforming text.
brew "gnu-sed"
# GNU archive creation and extraction tool.
brew "gnu-tar"
# Locate executables on PATH.
brew "gnu-which"
# Apply patch files to source files.
brew "gpatch"
# GNU text search tools: grep, egrep, and fgrep.
brew "grep"
# GNU compression and decompression utilities.
brew "gzip"
# Distributed version control.
brew "git"
# Transfer data over HTTP, HTTPS, and other protocols.
brew "curl"
# Interactive shell with autosuggestions and completions.
brew "fish"
# Configurable prompt shared across shells.
brew "starship"
# Display files with syntax highlighting.
brew "bat"
# Find files and directories with a concise interface.
brew "fd"
# Interactively filter and select command output.
brew "fzf"
# Query and transform JSON data.
brew "jq"
# Query and transform YAML, JSON, and XML data.
brew "yq"
# Extensible terminal text editor.
brew "neovim"
# Search file contents recursively.
brew "ripgrep"
# Efficiently copy and synchronize files.
brew "rsync"
# Find and replace text with a concise interface.
brew "sd"
# Display and inspect running processes.
brew "procs"
# Browse text a screen at a time.
brew "less"
# Additional Unix text and pipeline utilities.
brew "moreutils"
# Run a command repeatedly and display its output.
brew "watch"
# Run commands when watched files change.
brew "watchexec"
# Download files over HTTP, HTTPS, and FTP.
brew "wget"
# Navigate frequently used directories.
brew "zoxide"
